+
+final class _FakeBatchMetadataResolver
+    implements MangaBrowseMetadataResolver, MangaBrowseMetadataBatchResolver {
+  _FakeBatchMetadataResolver(this.metadata);
+
+  final Map<String, MangaBrowseMetadata> metadata;
+  int batchCalls = 0;
+  int singleCalls = 0;
+
+  @override
+  Future<MangaBrowseMetadata> metadataForWork(String workId) async {
+    singleCalls += 1;
+    return metadata[workId] ?? const MangaBrowseMetadata();
+  }
+
+  @override
+  Future<Map<String, MangaBrowseMetadata>> metadataForWorks(
+    Iterable<String> workIds,
+  ) async {
+    batchCalls += 1;
+    final requested = workIds.toSet();
+    return {
+      for (final entry in metadata.entries)
+        if (requested.contains(entry.key)) entry.key: entry.value,
+    };
   }
