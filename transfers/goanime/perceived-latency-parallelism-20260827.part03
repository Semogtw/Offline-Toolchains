+  Future<Map<String, MangaWorkMetadata>> _resolveMetadataForRecords(
+    List<MangaAvailabilityRecord> records,
+    MangaBrowseLocalState localState,
+  ) async {
+    final resolved = <String, MangaWorkMetadata>{
+      for (final record in records)
+        record.work.workId: record.metadata.merge(
+          localState.metadataByWorkId[record.work.workId] ??
+              const MangaWorkMetadata(),
+        ),
+    };
+    final resolver = _metadataResolver;
+    if (resolver == null || resolved.isEmpty) return resolved;
+
+    if (resolver is MangaBrowseMetadataBatchResolver) {
+      final batchResolver = resolver as MangaBrowseMetadataBatchResolver;
+      try {
+        final batch = await batchResolver.metadataForWorks(resolved.keys);
+        for (final entry in batch.entries) {
+          final current = resolved[entry.key];
+          if (current != null) resolved[entry.key] = current.merge(entry.value);
+        }
+        return resolved;
+      } catch (_) {
+        // Preserve the existing best-effort behavior. Falling back to the
+        // compatibility API also supports custom resolvers that expose a
+        // batch facade but cannot satisfy a particular request.
+      }
+    }
+
+    for (final workId in resolved.keys.toList(growable: false)) {
+      resolved[workId] = await _resolveMetadata(workId, resolved[workId]!);
+    }
+    return resolved;
