         r"_progressSaveQueue\s*=\s*_progressSaveQueue",
-        r"\.catchError\(\(Object _\) \{\}\)\s*\.then\(\(_\) async",
         r"final prefs = await SharedPreferences\.getInstance\(\);",
         r"await prefs\.setInt\(_positionKey, pos\);",
         r"await prefs\.remove\(_positionKey\);",
@@ -56,6 +55,23 @@ CHECKS = {
 }
 
 
+def _has_owned_progress_save_queue(source: str) -> bool:
+    assignment = "_progressSaveQueue = _progressSaveQueue"
+    start = source.find(assignment)
+    if start < 0:
+        return False
+
+    catch_error = source.find(".catchError", start + len(assignment))
+    then = source.find(".then", start + len(assignment))
+    statement_end = source.find(";", start + len(assignment))
+
+    if catch_error < 0 or then < 0:
+        return False
+    if not (start < catch_error < then):
+        return False
+    return statement_end < 0 or then < statement_end
+
+
 def main() -> int:
     failures: list[str] = []
     for relative, patterns in CHECKS.items():
@@ -63,6 +79,11 @@ def main() -> int:
         for pattern in patterns:
             if not re.search(pattern, source, re.DOTALL):
                 failures.append(f"{relative}: missing /{pattern}/")
+        if relative.endswith("desktop_video_player_screen_methods_2.dart"):
+            if not _has_owned_progress_save_queue(source):
+                failures.append(
+                    f"{relative}: progress save queue must catch errors before chaining then"
+                )
 
     if failures:
         print("FAIL external-future-ownership", file=sys.stderr)
