diff --git a/tools/tests/test_validate_external_future_ownership.py b/tools/tests/test_validate_external_future_ownership.py
new file mode 100644
index 00000000..8eccdc40
--- /dev/null
+++ b/tools/tests/test_validate_external_future_ownership.py
@@ -0,0 +1,38 @@
+from __future__ import annotations
+
+import re
+import unittest
+
+from tools.validate_external_future_ownership import CHECKS
+
+
+class ExternalFutureOwnershipValidatorTest(unittest.TestCase):
+    def test_progress_save_queue_guard_accepts_dart_formatted_callback(self) -> None:
+        patterns = CHECKS[
+            "lib/platform/desktop/screens/desktop_video_player_screen_methods_2.dart"
+        ]
+        queue_pattern = next(pattern for pattern in patterns if "catchError" in pattern)
+        formatted = """
+_progressSaveQueue = _progressSaveQueue
+    .catchError(
+      (Object _) {},
+    )
+    .then((_) async {
+      // serial save work
+    });
+"""
+
+        self.assertIsNotNone(re.search(queue_pattern, formatted, re.DOTALL))
+
+    def test_progress_save_queue_guard_rejects_unhandled_chain(self) -> None:
+        patterns = CHECKS[
+            "lib/platform/desktop/screens/desktop_video_player_screen_methods_2.dart"
+        ]
+        queue_pattern = next(pattern for pattern in patterns if "catchError" in pattern)
+        unsafe = "_progressSaveQueue = _progressSaveQueue.then((_) async {});"
+
+        self.assertIsNone(re.search(queue_pattern, unsafe, re.DOTALL))
+
+
+if __name__ == "__main__":
+    unittest.main()
+diff --git a/tools/validate_external_future_ownership.py b/tools/validate_external_future_ownership.py
+index 72f81de0..bee15fac 100644
+--- a/tools/validate_external_future_ownership.py
++++ b/tools/validate_external_future_ownership.py
+@@ -15,7 +15,7 @@ CHECKS = {
+     ],
+     "lib/platform/desktop/screens/desktop_video_player_screen_methods_2.dart": [
+         r"_progressSaveQueue\s*=\s*_progressSaveQueue",
+-        r"\.catchError\(\(Object _\) \{\}\)\s*\.then\(\(_\) async",
++        r"\.catchError\(\s*\(Object _\)\s*\{\}\s*,?\s*\)\s*\.then\(\s*\(_\)\s*async",
+         r"final prefs = await SharedPreferences\.getInstance\(\);",
+         r"await prefs\.setInt\(_positionKey, pos\);",
+         r"await prefs\.remove\(_positionKey\);",
+-- 
