+from __future__ import annotations
+
+import unittest
+
+from tools.validate_external_future_ownership import _has_owned_progress_save_queue
+
+
+class ExternalFutureOwnershipValidatorTest(unittest.TestCase):
+    def test_progress_save_queue_accepts_dart_format_variants(self) -> None:
+        variants = [
+            """
+_progressSaveQueue = _progressSaveQueue
+    .catchError(
+      (Object _) {},
+    )
+    .then((_) async {
+      final prefs = await SharedPreferences.getInstance();
+    });
+""",
+            """
+_progressSaveQueue = _progressSaveQueue
+    .catchError((Object _) {})
+    .then(
+      (_) async {
+        final prefs = await SharedPreferences.getInstance();
+      },
+    );
+""",
+        ]
+        for source in variants:
+            with self.subTest(source=source):
+                self.assertTrue(_has_owned_progress_save_queue(source))
+
+    def test_progress_save_queue_rejects_unhandled_or_late_catch(self) -> None:
+        unsafe_variants = [
+            "_progressSaveQueue = _progressSaveQueue.then((_) async {});",
+            """
+_progressSaveQueue = _progressSaveQueue.then((_) async {
+  someOtherFuture.catchError((Object _) {});
+});
+""",
+            """
+_progressSaveQueue = _progressSaveQueue;
+_progressSaveQueue.catchError((Object _) {}).then((_) async {});
+""",
+        ]
+        for source in unsafe_variants:
+            with self.subTest(source=source):
+                self.assertFalse(_has_owned_progress_save_queue(source))
+
+
+if __name__ == "__main__":
+    unittest.main()
