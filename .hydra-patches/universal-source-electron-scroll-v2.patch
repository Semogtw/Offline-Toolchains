@@ -0,0 +1,75 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  ELECTRON_PASSIVE_SCROLL_MAX_STEPS,
+  ELECTRON_PASSIVE_SCROLL_WAIT_MS,
+  runElectronPassiveScroll,
+} from "./electron-passive-scroll";
+
+class FakeExecutor {
+  private metrics = [
+    { y: 0, viewport: 800, height: 2400 },
+    { y: 720, viewport: 800, height: 3200 },
+    { y: 1440, viewport: 800, height: 3200 },
+    { y: 2400, viewport: 800, height: 3200 },
+    { y: 2400, viewport: 800, height: 3200 },
+  ];
+
+  scrollCalls = 0;
+  resetCalls = 0;
+
+  async executeJavaScript(script: string) {
+    if (script.includes("scrollHeight")) {
+      return (
+        this.metrics.shift() ?? {
+          y: 2400,
+          viewport: 800,
+          height: 3200,
+        }
+      );
+    }
+    if (script.includes("scrollBy")) {
+      this.scrollCalls += 1;
+      return undefined;
+    }
+    if (script.includes("scrollTo")) {
+      this.resetCalls += 1;
+      return undefined;
+    }
+    throw new Error(`Unexpected script: ${script}`);
+  }
+}
+
+test("Electron passive scroll is bounded and stops after a stagnant bottom", async () => {
+  const executor = new FakeExecutor();
+  const waits: number[] = [];
+
+  const result = await runElectronPassiveScroll(executor, {
+    sleep: async (ms) => {
+      waits.push(ms);
+    },
+  });
+
+  assert.ok(result.steps > 0);
+  assert.ok(result.steps <= ELECTRON_PASSIVE_SCROLL_MAX_STEPS);
+  assert.equal(executor.scrollCalls, result.steps);
+  assert.equal(executor.resetCalls, 1);
+  assert.equal(result.grew, true);
+  assert.ok(waits.every((value) => value === ELECTRON_PASSIVE_SCROLL_WAIT_MS));
+});
+
+test("Electron passive scroll resets the page when cancelled", async () => {
+  const executor = new FakeExecutor();
+  const controller = new AbortController();
+  controller.abort();
+
+  await assert.rejects(
+    runElectronPassiveScroll(executor, {
+      signal: controller.signal,
+      sleep: async () => undefined,
+    }),
+    (error: unknown) =>
+      error instanceof DOMException && error.name === "AbortError"
+  );
+  assert.equal(executor.resetCalls, 1);
+});
