@@ -0,0 +1,123 @@
+export const ELECTRON_PASSIVE_SCROLL_MAX_STEPS = 8;
+export const ELECTRON_PASSIVE_SCROLL_WAIT_MS = 250;
+
+interface ScriptExecutor {
+  executeJavaScript(script: string, userGesture?: boolean): Promise<unknown>;
+}
+
+interface PassiveScrollMetrics {
+  y: number;
+  viewport: number;
+  height: number;
+}
+
+export interface ElectronPassiveScrollOptions {
+  signal?: AbortSignal;
+  maxSteps?: number;
+  waitMs?: number;
+  sleep?: (ms: number, signal?: AbortSignal) => Promise<void>;
+}
+
+function abortError() {
+  return new DOMException("Electron passive scroll was cancelled", "AbortError");
+}
+
+function parseMetrics(value: unknown): PassiveScrollMetrics | null {
+  if (!value || typeof value !== "object") return null;
+  const record = value as Record<string, unknown>;
+  const y = Number(record.y);
+  const viewport = Number(record.viewport);
+  const height = Number(record.height);
+  if (![y, viewport, height].every(Number.isFinite)) return null;
+  if (viewport <= 0 || height <= 0) return null;
+  return {
+    y: Math.max(0, y),
+    viewport: Math.max(1, viewport),
+    height: Math.max(0, height),
+  };
+}
+
+function defaultSleep(ms: number, signal?: AbortSignal) {
+  return new Promise<void>((resolve, reject) => {
+    if (signal?.aborted) {
+      reject(abortError());
+      return;
+    }
+
+    let timer: NodeJS.Timeout;
+    const onAbort = () => {
+      clearTimeout(timer);
+      signal?.removeEventListener("abort", onAbort);
+      reject(abortError());
+    };
+    timer = setTimeout(() => {
+      signal?.removeEventListener("abort", onAbort);
+      resolve();
+    }, ms);
+    signal?.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+export async function runElectronPassiveScroll(
+  executor: ScriptExecutor,
+  options: ElectronPassiveScrollOptions = {}
+) {
+  const maxSteps = Math.max(
+    1,
+    Math.min(
+      options.maxSteps ?? ELECTRON_PASSIVE_SCROLL_MAX_STEPS,
+      ELECTRON_PASSIVE_SCROLL_MAX_STEPS
+    )
+  );
+  const waitMs = Math.max(
+    0,
+    Math.min(options.waitMs ?? ELECTRON_PASSIVE_SCROLL_WAIT_MS, 1_000)
+  );
+  const sleep = options.sleep ?? defaultSleep;
+  let lastHeight = -1;
+  let stagnantBottoms = 0;
+  let steps = 0;
+  let grew = false;
+
+  try {
+    for (let index = 0; index < maxSteps; index += 1) {
+      if (options.signal?.aborted) throw abortError();
+      const metrics = parseMetrics(
+        await executor.executeJavaScript(
+          `(() => ({
+            y: Math.max(window.scrollY || 0, document.documentElement.scrollTop || 0),
+            viewport: Math.max(window.innerHeight || 0, 1),
+            height: Math.max(
+              document.body ? document.body.scrollHeight : 0,
+              document.documentElement ? document.documentElement.scrollHeight : 0
+            )
+          }))()`,
+          false
+        )
+      );
+      if (!metrics) break;
+
+      if (lastHeight >= 0 && metrics.height > lastHeight) grew = true;
+      const atBottom = metrics.y + metrics.viewport >= metrics.height - 4;
+      if (atBottom && metrics.height <= lastHeight) {
+        stagnantBottoms += 1;
+        if (stagnantBottoms >= 2) break;
+      } else {
+        stagnantBottoms = 0;
+      }
+
+      await executor.executeJavaScript(
+        "window.scrollBy(0, Math.max(window.innerHeight * 0.9, 600))",
+        false
+      );
+      steps += 1;
+      await sleep(waitMs, options.signal);
+      lastHeight = Math.max(lastHeight, metrics.height);
+    }
+  } finally {
+    await executor
+      .executeJavaScript("window.scrollTo(0, 0)", false)
+      .catch(() => undefined);
+  }
+
+  return { steps, grew };
+}
