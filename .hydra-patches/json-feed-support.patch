--- a/src/main/services/local-download-sources/generic-json-extractor.test.ts
+++ b/src/main/services/local-download-sources/generic-json-extractor.test.ts
@@ -126,3 +126,39 @@ test("does not absorb child records into a titled parent", () => {
     ["Game A", "Game B"]
   );
 });
+
+test("extracts JSON Feed attachments while keeping next_url as navigation", () => {
+  const result = extractGenericJsonCandidates({
+    pageUrl: "https://catalog.example/feed.json",
+    body: JSON.stringify({
+      version: "https://jsonfeed.org/version/1.1",
+      title: "Games Feed",
+      next_url: "/feed-2.json",
+      items: [
+        {
+          id: "game-1",
+          title: "JSON Feed Game",
+          attachments: [
+            {
+              url: "/files/json-feed-game.zip",
+              mime_type: "application/zip",
+              size_in_bytes: 123456,
+            },
+          ],
+        },
+      ],
+    }),
+  });
+
+  assert.equal(result.candidates.length, 1);
+  assert.equal(result.candidates[0].title, "JSON Feed Game");
+  assert.deepEqual(
+    result.candidates[0].uriCandidates.map((item) => item.uri),
+    ["https://catalog.example/files/json-feed-game.zip"]
+  );
+  assert.ok(
+    result.discoveredUrls.includes("https://catalog.example/feed-2.json")
+  );
+  assert.equal(
+    result.candidates[0].uriCandidates.some((item) => item.uri.endsWith("feed-2.json")),
+    false
+  );
+});
