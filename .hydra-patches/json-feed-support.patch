 });
+
+test("crawler accepts JSON Feed transport, attachments and next_url pagination", async () => {
+  const origin = "https://example.com";
+  const source = {
+    ...(await makeSource(origin)),
+    startUrl: `${origin}/feed.json`,
+  };
+  const fetchImpl: typeof fetch = async (input) => {
+    const url = String(input);
+    if (url.endsWith("/robots.txt")) {
+      return new Response("User-agent: *\n", {
+        status: 200,
+        headers: { "content-type": "text/plain" },
+      });
+    }
+    if (url.endsWith("/feed.json")) {
+      return new Response(
+        JSON.stringify({
+          version: "https://jsonfeed.org/version/1.1",
+          title: "Games Feed",
+          next_url: `${origin}/feed-2.json`,
+          items: [
+            {
+              id: "game-1",
+              title: "HTTP JSON Feed Game",
+              attachments: [
+                {
+                  url: `${origin}/files/http-json-feed-game.zip`,
+                  mime_type: "application/zip",
+                },
+              ],
+            },
+          ],
+        }),
+        { status: 200, headers: { "content-type": "application/feed+json" } }
+      );
+    }
+    if (url.endsWith("/feed-2.json")) {
+      return new Response(
+        JSON.stringify({
+          version: "https://jsonfeed.org/version/1.1",
+          title: "Games Feed 2",
+          items: [],
+        }),
+        { status: 200, headers: { "content-type": "application/feed+json" } }
+      );
+    }
+    return new Response("not found", {
+      status: 404,
+      headers: { "content-type": "text/plain" },
+    });
+  };
+
+  const result = await crawlHttpSource({ source, fetchImpl });
+
+  assert.equal(result.errors.length, 0);
+  assert.ok(result.visitedUrls.includes(`${origin}/feed-2.json`));
+  const candidate = result.candidates.find(
+    (item) => item.title === "HTTP JSON Feed Game"
+  );
+  assert.ok(candidate);
+  assert.deepEqual(candidate.uriCandidates.map((item) => item.uri), [
+    `${origin}/files/http-json-feed-game.zip`,
+  ]);
+});
