diff --git a/src/main/services/download/download-manager.ts b/src/main/services/download/download-manager.ts
--- a/src/main/services/download/download-manager.ts
+++ b/src/main/services/download/download-manager.ts
@@ -1117,6 +1117,24 @@ export class DownloadManager {
         return this.getVikingFileDownloadOptions(download, resumingFilename);
       case Downloader.Rootz:
         return this.getRootzDownloadOptions(download, resumingFilename);
+      case Downloader.DirectHttp: {
+        let parsed: URL;
+        try {
+          parsed = new URL(download.uri);
+        } catch {
+          throw new Error("Invalid direct HTTP download URL");
+        }
+
+        if (
+          !["http:", "https:"].includes(parsed.protocol) ||
+          parsed.username ||
+          parsed.password
+        ) {
+          throw new Error("Invalid direct HTTP download URL");
+        }
+
+        const directUrl = parsed.toString();
+        const filename = this.resolveFilename(
+          resumingFilename,
+          download.uri,
+          directUrl
+        );
+        return this.buildDownloadOptions(directUrl, download.downloadPath, filename);
+      }
       default:
         return null;
     }
