@@ -0,0 +1,36 @@
+import { isAnkerGamesHost } from "./ankergames-adapter";
+
+const DEFERRED_PATH = /^\/generate-download-url\/(\d+)\/?$/;
+
+export function createAnkerGamesDeferredDownloadUrl(downloadId: number) {
+  if (!Number.isSafeInteger(downloadId) || downloadId <= 0) {
+    throw new Error("AnkerGames download ID must be a positive safe integer");
+  }
+  return `https://ankergames.net/generate-download-url/${downloadId}`;
+}
+
+export function parseAnkerGamesDeferredDownloadUrl(value: string) {
+  try {
+    const parsed = new URL(value);
+    if (
+      parsed.protocol !== "https:" ||
+      !isAnkerGamesHost(parsed.hostname) ||
+      parsed.username ||
+      parsed.password ||
+      parsed.search ||
+      parsed.hash
+    ) {
+      return null;
+    }
+    const match = DEFERRED_PATH.exec(parsed.pathname);
+    if (!match) return null;
+    const downloadId = Number(match[1]);
+    return Number.isSafeInteger(downloadId) && downloadId > 0
+      ? downloadId
+      : null;
+  } catch {
+    return null;
+  }
+}
