+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  createAnkerGamesDeferredDownloadUrl,
+  parseAnkerGamesDeferredDownloadUrl,
+} from "./ankergames-deferred-download";
+
+test("round-trips the exact allowlisted AnkerGames deferred endpoint", () => {
+  const url = createAnkerGamesDeferredDownloadUrl(4358);
+  assert.equal(url, "https://ankergames.net/generate-download-url/4358");
+  assert.equal(parseAnkerGamesDeferredDownloadUrl(url), 4358);
+  assert.equal(
+    parseAnkerGamesDeferredDownloadUrl(
+      "https://www.ankergames.net/generate-download-url/4358"
+    ),
+    4358
+  );
+});
+
+test("rejects lookalike hosts and non-exact deferred endpoints", () => {
+  assert.equal(
+    parseAnkerGamesDeferredDownloadUrl(
+      "https://evil.test/generate-download-url/4358"
+    ),
+    null
+  );
+  assert.equal(parseAnkerGamesDeferredDownloadUrl("https://ankergames.net/generate-download-url/0"), null);
+  assert.equal(parseAnkerGamesDeferredDownloadUrl("https://ankergames.net/generate-download-url/4358?x=1"), null);
+});
