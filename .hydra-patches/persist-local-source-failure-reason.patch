diff --git a/src/main/services/local-download-sources/source-repository.test.ts b/src/main/services/local-download-sources/source-repository.test.ts
--- a/src/main/services/local-download-sources/source-repository.test.ts
+++ b/src/main/services/local-download-sources/source-repository.test.ts
@@ -420,3 +420,31 @@ test("does not apply catastrophic shrink protection to small prior catalogues", async () => {
   assert.equal(updated.activeRunId, "run-small");
   assert.equal(updated.stats.entries, 1);
 });
+
+test("preserves the specific failure message without changing the failed status", async () => {
+  const { repository } = createMemoryRepository();
+  await repository.createLocalSource({
+    name: "Example",
+    startUrl: "https://example.com/catalogue",
+  });
+  await repository.writeStagedEntries("source-a", "run-base", [
+    { ...entry, id: "entry-base", runId: "run-base" },
+  ]);
+  await repository.activateGeneration(
+    "source-a",
+    "run-base",
+    { ...report, runId: "run-base" },
+    sourceSpec
+  );
+  await repository.markRunStarted("source-a", "run-failed");
+
+  await repository.discardGeneration(
+    "source-a",
+    "run-failed",
+    "failed",
+    "A estrutura da fonte mudou e o catálogo anterior foi preservado"
+  );
+
+  const source = await repository.getSource("source-a");
+  assert.equal(source?.status, "failed");
+  assert.equal(source?.activeRunId, "run-base");
+  assert.equal(
+    source?.lastError,
+    "A estrutura da fonte mudou e o catálogo anterior foi preservado"
+  );
+});
