diff --git a/test/tools/build_mal_provider_availability_cache_test.dart b/test/tools/build_mal_provider_availability_cache_test.dart
index a6aa4de6..97d64591 100644
--- a/test/tools/build_mal_provider_availability_cache_test.dart
+++ b/test/tools/build_mal_provider_availability_cache_test.dart
@@ -63,6 +63,68 @@ void main() {
     },
   );
 
+  test('reconciles legacy aliases without inventing provider ownership', () {
+    final providerRaw = <String, Object?>{
+      'schemaVersion': 1,
+      'generatedAt': '2026-08-10T00:00:00Z',
+      'legacyBaseline': <Object?>[
+        <String, Object?>{
+          'title': '3-gatsu no Lion',
+          'sub': true,
+          'dub': false,
+        },
+        <String, Object?>{
+          'title': 'Historical Only',
+          'sub': true,
+          'dub': false,
+        },
+      ],
+      'providers': <String, Object?>{
+        'animesonline': <String, Object?>{
+          'status': 'complete',
+          'lastAttemptAt': '2026-08-10T00:00:00Z',
+          'lastSuccessfulAt': '2026-08-10T00:00:00Z',
+          'entries': <Object?>[
+            <String, Object?>{
+              'title': 'Sangatsu no Lion',
+              'sub': true,
+              'dub': false,
+            },
+          ],
+        },
+      },
+    };
+    final malRaw = <String, Object?>{
+      'schemaVersion': 1,
+      'entries': <Object?>[
+        <String, Object?>{
+          'malId': 31646,
+          'canonicalTitle': '3-gatsu no Lion',
+          'matchedAvailableTitles': <String>[
+            '3 gatsu no lion',
+            'sangatsu no lion',
+          ],
+        },
+      ],
+    };
+
+    final document = builder.buildMalProviderAvailabilityDocument(
+      providerRaw: providerRaw,
+      malRaw: malRaw,
+      generatedAt: DateTime.utc(2026, 8, 10),
+    );
+
+    final reconciliation =
+        document['legacyBaselineReconciliation']! as Map<String, Object?>;
+    expect(reconciliation['baselineTitleCount'], 2);
+    expect(reconciliation['currentProviderUnionTitleCount'], 1);
+    expect(reconciliation['legacyOnlyTitleCount'], 2);
+    expect(reconciliation['legacyOnlyWithMalMatchCount'], 1);
+    expect(reconciliation['legacyOnlyAliasCoveredByCurrentTitleCount'], 1);
+    expect(reconciliation['legacyOnlyWithoutMalMatchCount'], 1);
+    expect(reconciliation['legacyOnlyAwaitingProviderRevalidationCount'], 1);
+  });
+
