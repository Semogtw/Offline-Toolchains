+  Future<void> saveReadingProgress({
+    required String workId,
+    required String canonicalChapterId,
+    required MangaVariantBookmark bookmark,
+    required bool completed,
+    required DateTime lastReadAt,
+  }) async {
+    _validateIdentity(workId, canonicalChapterId);
+    final database = await _database.database;
+    await database.transaction((transaction) async {
+      final values = <String, Object?>{
+        'completed': completed ? 1 : 0,
+        'lastReadAt': lastReadAt.toUtc().toIso8601String(),
+        'sourceId': bookmark.sourceId,
+        'mangaId': bookmark.mangaId,
+        'chapterId': bookmark.chapterId,
+        'pageIndex': bookmark.pageIndex,
+        'pageCount': bookmark.pageCount,
+      };
+      final updated = await transaction.update(
+        'manga_progress',
+        values,
+        where: 'workId = ? AND canonicalChapterId = ?',
+        whereArgs: [workId, canonicalChapterId],
+      );
+      if (updated == 0) {
+        await transaction.insert('manga_progress', <String, Object?>{
+          'workId': workId,
+          'canonicalChapterId': canonicalChapterId,
+          ...values,
+        });
+      }
+    });
+  }
