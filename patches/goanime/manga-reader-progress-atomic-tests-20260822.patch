+  test('reading progress writes bookmark and logical state together', () async {
+    final readAt = DateTime.utc(2026, 8, 22, 18, 30);
+
+    await progressRepository.saveReadingProgress(
+      workId: 'mw_test',
+      canonicalChapterId: 'mc_1',
+      bookmark: MangaVariantBookmark(
+        sourceId: 'ptbr.atomic',
+        mangaId: 'work-atomic',
+        chapterId: 'chapter-atomic-1',
+        pageIndex: 7,
+        pageCount: 20,
+      ),
+      completed: true,
+      lastReadAt: readAt,
+    );
+
+    final progress = await progressRepository.progressForChapter(
+      'mw_test',
+      'mc_1',
+    );
+
+    expect(progress, isNotNull);
+    expect(progress!.completed, isTrue);
+    expect(progress.lastReadAt, readAt);
+    expect(progress.bookmark!.sourceId, 'ptbr.atomic');
+    expect(progress.bookmark!.mangaId, 'work-atomic');
+    expect(progress.bookmark!.chapterId, 'chapter-atomic-1');
+    expect(progress.bookmark!.pageIndex, 7);
+    expect(progress.bookmark!.pageCount, 20);
+  });
 
