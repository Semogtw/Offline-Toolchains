+  KeyEventResult _handleKeyEvent(FocusNode node, KeyEvent event) {
+    if (event is! KeyDownEvent || _openingReaderRoute) {
+      return KeyEventResult.ignored;
+    }
+    final key = event.logicalKey;
+    if (key == LogicalKeyboardKey.f11) {
+      unawaited(_toggleDesktopFullscreen());
+      return KeyEventResult.handled;
+    }
+    if (key == LogicalKeyboardKey.escape) {
+      if (_desktopFullscreen) {
+        unawaited(_toggleDesktopFullscreen());
+      } else {
+        _toggleChrome();
+      }
+      return KeyEventResult.handled;
+    }
+    if (!_supportsImageModes) return KeyEventResult.ignored;
+
+    if (_readerMode == MangaReaderMode.continuousVertical) {
+      if (key == LogicalKeyboardKey.arrowDown ||
+          key == LogicalKeyboardKey.pageDown ||
+          key == LogicalKeyboardKey.space) {
+        _scrollContinuousBy(1);
+        return KeyEventResult.handled;
+      }
+      if (key == LogicalKeyboardKey.arrowUp ||
+          key == LogicalKeyboardKey.pageUp) {
+        _scrollContinuousBy(-1);
+        return KeyEventResult.handled;
+      }
+      return KeyEventResult.ignored;
+    }
+
+    final nextKey = switch (_readerMode) {
+      MangaReaderMode.pagedRtl => LogicalKeyboardKey.arrowLeft,
+      MangaReaderMode.pagedLtr => LogicalKeyboardKey.arrowRight,
+      MangaReaderMode.pagedVertical => LogicalKeyboardKey.arrowDown,
+      MangaReaderMode.continuousVertical => LogicalKeyboardKey.arrowDown,
+    };
+    final previousKey = switch (_readerMode) {
+      MangaReaderMode.pagedRtl => LogicalKeyboardKey.arrowRight,
+      MangaReaderMode.pagedLtr => LogicalKeyboardKey.arrowLeft,
+      MangaReaderMode.pagedVertical => LogicalKeyboardKey.arrowUp,
+      MangaReaderMode.continuousVertical => LogicalKeyboardKey.arrowUp,
+    };
+    if (key == nextKey ||
+        key == LogicalKeyboardKey.pageDown ||
+        key == LogicalKeyboardKey.space) {
+      _movePagedReader(1);
+      return KeyEventResult.handled;
+    }
+    if (key == previousKey || key == LogicalKeyboardKey.pageUp) {
+      _movePagedReader(-1);
+      return KeyEventResult.handled;
+    }
+    return KeyEventResult.ignored;
+  }
+
+  void _movePagedReader(int delta) {
+    final controller = _imageController;
+    final count = _pageCount;
+    if (controller == null ||
+        !controller.hasClients ||
+        count == null ||
+        count <= 0) {
+      return;
+    }
+    final target = (_pageIndex + delta).clamp(0, count - 1).toInt();
+    if (target == _pageIndex) return;
+    unawaited(
+      controller.animateToPage(
+        target,
+        duration: const Duration(milliseconds: 180),
+        curve: Curves.easeOutCubic,
+      ),
+    );
+  }
+
+  void _scrollContinuousBy(int direction) {
+    final controller = _continuousController;
+    if (controller == null || !controller.hasClients) return;
+    final position = controller.position;
+    final target =
+        (controller.offset + position.viewportDimension * 0.85 * direction)
+            .clamp(position.minScrollExtent, position.maxScrollExtent)
+            .toDouble();
+    unawaited(
+      controller.animateTo(
+        target,
+        duration: const Duration(milliseconds: 180),
+        curve: Curves.easeOutCubic,
+      ),
+    );
+  }
+
+  Future<void> _toggleDesktopFullscreen() async {
+    if (!DesktopWindowService.isSupported || _openingReaderRoute) return;
+    final next = !_desktopFullscreen;
+    final applied = await DesktopWindowService.setFullScreen(
+      next,
+      maximizeOnExit: !next,
+    );
+    if (!mounted || !applied) return;
+    setState(() {
+      _desktopFullscreen = next;
+      _chromeVisible = !next;
+    });
+  }
