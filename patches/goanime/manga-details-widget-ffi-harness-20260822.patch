+
+Future<void> _pumpUntilLibraryStatus(
+  WidgetTester tester,
+  MangaLibraryRepository library,
+  MangaLibraryStatus expected,
+) async {
+  for (var i = 0; i < 80; i += 1) {
+    await tester.pump(const Duration(milliseconds: 50));
+    await _yieldToIo(tester);
+    final entry = await tester.runAsync(
+      () => library.entryForWork('mw_library'),
+    );
+    if (entry?.status == expected) return;
+  }
+  throw TestFailure('Timed out waiting for manga library status.');
+}
+
+Future<void> _yieldToIo(WidgetTester tester) async {
+  await tester.runAsync(() async {
+    await Future<void>.delayed(const Duration(milliseconds: 10));
+  });
+}
